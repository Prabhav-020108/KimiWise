# ─── KimiWise — Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Google AI (Gemma 4 via AI Studio) ────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Override the default Gemma model (optional)
# GEMMA_MODEL=gemma-3-27b-it

# ── Ollama (Local AI Fallback) ────────────────────────────────────────────────
# Install Ollama: https://ollama.com
# Then run: ollama pull gemma3:2b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:2b

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
SERVER_PORT=3030

# Production: Lock CORS to your Vercel domain
# ALLOWED_ORIGIN=https://kimiwise.vercel.app

# ── AI Mode Override (optional) ───────────────────────────────────────────────
# auto = use Gemma if key present, else Ollama
# gemma = force Gemma (requires GOOGLE_AI_API_KEY)
# ollama = force local Ollama
# AI_MODE=auto
